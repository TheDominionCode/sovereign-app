# Supabase project URL and publishable (anon) key.
# Find these in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role secret. Required: the Stripe webhook uses it to bypass RLS
# when writing subscription state.
# NEVER commit. NEVER expose to the browser.
SUPABASE_SECRET_KEY=

# Public base URL of this app — used in Stripe success_url / cancel_url and
# Supabase auth redirects. Set to http://localhost:3000 locally; deploy URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth credentials — only needed for LOCAL `supabase start` to run
# the Google sign-in flow. Production reads these from the Supabase Dashboard
# (Authentication -> Providers -> Google). Create the OAuth client in Google
# Cloud Console; add http://127.0.0.1:54321/auth/v1/callback as a redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Stripe keys. Use test-mode keys (sk_test_…, pk_test_…) for local dev.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret. Locally, this comes from `stripe listen`.
# Production has a separate whsec_… registered in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Four Stripe Price IDs — one per billing interval.
# Create the Product + Prices in the Stripe Dashboard, then paste the IDs here.
#   $14.99 / month
#   $39.99 / 3 months
#   $74.99 / 6 months
#   $99.99 / year
STRIPE_PRICE_1MO=
STRIPE_PRICE_3MO=
STRIPE_PRICE_6MO=
STRIPE_PRICE_12MO=
